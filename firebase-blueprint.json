{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator marker document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Verified administrator email."
        },
        "creatorHandle": {
          "type": "string",
          "description": "Creator TikTok handle (@kadirofficial007)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted (FieldValue.serverTimestamp())."
        }
      },
      "required": ["email", "createdAt"]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "An app package or curated link published by an admin or community uploader (pending admin approval) with AES-256-GCM encrypted target metadata and optional app icon.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Display title of the app or link."
        },
        "description": {
          "type": "string",
          "description": "Detailed description or usage instructions."
        },
        "whatsNew": {
          "type": "string",
          "description": "Optional changelog / release notes for the current version."
        },
        "category": {
          "type": "string",
          "enum": ["App", "Link", "Tool", "Game", "Resource"],
          "description": "Catalog category."
        },
        "itemType": {
          "type": "string",
          "enum": ["link", "encrypted_file"],
          "description": "Whether the item points to an encrypted external link or an encrypted vault file."
        },
        "version": {
          "type": "string",
          "description": "Version tag (e.g., 1.0.0)."
        },
        "fileSizeLabel": {
          "type": "string",
          "description": "Human-readable file size or link badge."
        },
        "creatorHandle": {
          "type": "string",
          "description": "Platform creator attribution handle (@kadirofficial007)."
        },
        "encryptedTargetUrl": {
          "type": "string",
          "description": "Base64 AES-256-GCM encrypted download URL or external link."
        },
        "urlIv": {
          "type": "string",
          "description": "Base64 12-byte GCM initialization vector for encryptedTargetUrl."
        },
        "encryptedFileId": {
          "type": "string",
          "description": "Document ID in /encrypted_files when itemType is encrypted_file, or empty string."
        },
        "sha256Checksum": {
          "type": "string",
          "description": "SHA-256 hex digest for payload integrity verification."
        },
        "encryptionAlgorithm": {
          "type": "string",
          "enum": ["AES-256-GCM"],
          "description": "Cryptographic cipher identifier."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "flagged", "archived"],
          "description": "Moderation and approval visibility status."
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Admin-curated spotlight flag shown in the Explore Featured carousel."
        },
        "moderationNote": {
          "type": "string",
          "description": "Optional feedback note from the admin when approving, flagging, or rejecting an upload."
        },
        "downloadCount": {
          "type": "integer",
          "description": "Total verified download or link open count."
        },
        "averageRating": {
          "type": "number",
          "description": "Aggregate user rating between 0.0 and 5.0."
        },
        "reviewCount": {
          "type": "integer",
          "description": "Total number of visible reviews."
        },
        "uploaderUid": {
          "type": "string",
          "description": "Firebase Auth UID of the user or admin who uploaded the item."
        },
        "uploaderName": {
          "type": "string",
          "description": "Display name of the uploader."
        },
        "iconBase64": {
          "type": "string",
          "description": "Optional Base64-encoded compressed app icon image."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "itemType",
        "version",
        "fileSizeLabel",
        "creatorHandle",
        "encryptedTargetUrl",
        "urlIv",
        "encryptedFileId",
        "sha256Checksum",
        "encryptionAlgorithm",
        "status",
        "downloadCount",
        "averageRating",
        "reviewCount",
        "uploaderUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "EncryptedFile": {
      "title": "EncryptedFile",
      "description": "AES-256-GCM encrypted file manifest stored in Firestore (supports single-document payloads <= 450 KB and chunked APKs/files up to 50 MB via /chunks subcollection).",
      "type": "object",
      "properties": {
        "catalogItemId": {
          "type": "string",
          "description": "Parent catalog item document ID."
        },
        "fileName": {
          "type": "string",
          "description": "Original file name (e.g., app-release.apk)."
        },
        "mimeType": {
          "type": "string",
          "description": "Original MIME type."
        },
        "byteSize": {
          "type": "integer",
          "description": "Plaintext byte length (up to 52,428,800 bytes / 50 MB)."
        },
        "chunkCount": {
          "type": "integer",
          "description": "0 for single-document ciphertextBase64 storage, or >= 1 when encrypted chunks are stored in /encrypted_files/{fileId}/chunks."
        },
        "ciphertextBase64": {
          "type": "string",
          "description": "Base64 AES-256-GCM encrypted file bytes when chunkCount == 0, otherwise empty string."
        },
        "ivBase64": {
          "type": "string",
          "description": "Base64 12-byte GCM initialization vector when chunkCount == 0, otherwise empty string."
        },
        "sha256Checksum": {
          "type": "string",
          "description": "64-character SHA-256 hex digest of original complete plaintext file."
        },
        "encryptionAlgorithm": {
          "type": "string",
          "enum": ["AES-256-GCM"],
          "description": "Cipher used to encrypt the file."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "flagged", "archived"],
          "description": "Moderation/approval status matching parent catalog item."
        },
        "uploaderUid": {
          "type": "string",
          "description": "UID of the user or admin who uploaded the encrypted file."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "catalogItemId",
        "fileName",
        "mimeType",
        "byteSize",
        "ciphertextBase64",
        "ivBase64",
        "sha256Checksum",
        "encryptionAlgorithm",
        "status",
        "uploaderUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "EncryptedFileChunk": {
      "title": "EncryptedFileChunk",
      "description": "Individual AES-256-GCM encrypted chunk of a larger APK or vault file stored under /encrypted_files/{fileId}/chunks/{chunkId}.",
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "description": "Parent /encrypted_files document ID."
        },
        "catalogItemId": {
          "type": "string",
          "description": "Parent /catalog_items document ID."
        },
        "chunkIndex": {
          "type": "integer",
          "description": "Zero-based sequential chunk index."
        },
        "byteSize": {
          "type": "integer",
          "description": "Plaintext byte length of this chunk."
        },
        "ciphertextBase64": {
          "type": "string",
          "description": "Base64 AES-256-GCM encrypted chunk bytes."
        },
        "ivBase64": {
          "type": "string",
          "description": "Base64 12-byte GCM initialization vector for this chunk."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "flagged", "archived"],
          "description": "Moderation status matching parent catalog item."
        },
        "uploaderUid": {
          "type": "string",
          "description": "UID of the uploader."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "fileId",
        "catalogItemId",
        "chunkIndex",
        "byteSize",
        "ciphertextBase64",
        "ivBase64",
        "status",
        "uploaderUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "User rating and review for a catalog item, subject to content moderation.",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "description": "Target catalog item ID."
        },
        "itemTitle": {
          "type": "string",
          "description": "Denormalized title of the reviewed item for moderation queue visibility."
        },
        "userId": {
          "type": "string",
          "description": "Author Firebase Auth UID."
        },
        "authorName": {
          "type": "string",
          "description": "Reviewer display name."
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5."
        },
        "comment": {
          "type": "string",
          "description": "Review text."
        },
        "moderationStatus": {
          "type": "string",
          "enum": ["visible", "flagged", "hidden"],
          "description": "Moderation state of the review."
        },
        "flagReason": {
          "type": "string",
          "description": "Optional reason provided when flagged or hidden."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "itemId",
        "itemTitle",
        "userId",
        "authorName",
        "rating",
        "comment",
        "moderationStatus",
        "flagReason",
        "createdAt",
        "updatedAt"
      ]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "User-submitted moderation report for a catalog item or review.",
      "type": "object",
      "properties": {
        "targetType": {
          "type": "string",
          "enum": ["catalog_item", "review"],
          "description": "Type of reported entity."
        },
        "targetId": {
          "type": "string",
          "description": "Document ID of the reported entity."
        },
        "targetTitle": {
          "type": "string",
          "description": "Summary label of the reported content."
        },
        "reporterUid": {
          "type": "string",
          "description": "Firebase Auth UID of the reporting user."
        },
        "reporterName": {
          "type": "string",
          "description": "Display name of the reporting user."
        },
        "reason": {
          "type": "string",
          "description": "Explanation for the moderation report."
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved", "dismissed"],
          "description": "Resolution status."
        },
        "adminNotes": {
          "type": "string",
          "description": "Moderator resolution notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "targetType",
        "targetId",
        "targetTitle",
        "reporterUid",
        "reporterName",
        "reason",
        "status",
        "adminNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Admin-published pinned hub announcement or broadcast notice shown in Explore.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short announcement headline."
        },
        "message": {
          "type": "string",
          "description": "Announcement body text."
        },
        "actionUrl": {
          "type": "string",
          "description": "Optional external action URL."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the announcement is visible to users."
        },
        "authorEmail": {
          "type": "string",
          "description": "Publishing admin email."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": ["title", "message", "active", "authorEmail", "createdAt", "updatedAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User-saved favorite catalog item marker under /users/{userId}/bookmarks/{itemId}.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "itemId": {
          "type": "string",
          "description": "Bookmarked catalog item ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        }
      },
      "required": ["userId", "itemId", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Trusted administrator access records."
    },
    "/catalog_items/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Community and admin uploaded apps/links with AES-256-GCM encrypted targets and admin approval gating."
    },
    "/encrypted_files/{fileId}": {
      "schema": { "$ref": "#/entities/EncryptedFile" },
      "description": "AES-256-GCM encrypted file manifests (single-doc or chunked up to 50 MB)."
    },
    "/encrypted_files/{fileId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/EncryptedFileChunk" },
      "description": "Encrypted chunks for APKs and large files."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "User ratings and reviews with moderation lifecycle."
    },
    "/moderation_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ModerationReport" },
      "description": "Content moderation reports queue."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Admin-broadcast hub notices and pinned updates."
    },
    "/users/{userId}/bookmarks/{itemId}": {
      "schema": { "$ref": "#/entities/Bookmark" },
      "description": "User-saved catalog bookmarks."
    }
  }
}
