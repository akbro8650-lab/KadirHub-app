rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin role resolved exclusively from verified kadir25.bd@gmail.com claim or trusted /admins/{uid} doc
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
         'email_verified' in request.auth.token &&
         request.auth.token.email == 'kadir25.bd@gmail.com' &&
         request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validators ---
    function isValidCatalogItem(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 2000 &&
             (!('whatsNew' in data) || (data.whatsNew is string && data.whatsNew.size() <= 1000)) &&
             data.category in ['App', 'Link', 'Tool', 'Game', 'Resource'] &&
             data.itemType in ['link', 'encrypted_file'] &&
             data.version is string && data.version.size() >= 1 && data.version.size() <= 40 &&
             data.fileSizeLabel is string && data.fileSizeLabel.size() <= 40 &&
             data.creatorHandle is string && data.creatorHandle.size() >= 1 && data.creatorHandle.size() <= 60 &&
             data.encryptedTargetUrl is string && data.encryptedTargetUrl.size() <= 4096 &&
             data.urlIv is string && data.urlIv.size() <= 128 &&
             data.encryptedFileId is string && data.encryptedFileId.size() <= 128 &&
             data.sha256Checksum is string && data.sha256Checksum.size() <= 128 &&
             data.encryptionAlgorithm == 'AES-256-GCM' &&
             data.status in ['pending', 'approved', 'flagged', 'archived'] &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             (!('moderationNote' in data) || (data.moderationNote is string && data.moderationNote.size() <= 400)) &&
             data.downloadCount is int && data.downloadCount >= 0 &&
             data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5 &&
             data.reviewCount is int && data.reviewCount >= 0 &&
             data.uploaderUid is string && data.uploaderUid.size() >= 1 && data.uploaderUid.size() <= 128 &&
             (!('uploaderName' in data) || (data.uploaderName is string && data.uploaderName.size() <= 80)) &&
             (!('iconBase64' in data) || (data.iconBase64 is string && data.iconBase64.size() <= 150000)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidEncryptedFile(data) {
      return data.catalogItemId is string && data.catalogItemId.size() >= 1 && data.catalogItemId.size() <= 128 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 255 &&
             data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 128 &&
             data.byteSize is int && data.byteSize > 0 && data.byteSize <= 52428800 &&
             (!('chunkCount' in data) || (data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 200)) &&
             (
               (!('chunkCount' in data) || data.chunkCount == 0)
                 ? (data.ciphertextBase64 is string && data.ciphertextBase64.size() >= 1 && data.ciphertextBase64.size() <= 900000 &&
                    data.ivBase64 is string && data.ivBase64.size() >= 1 && data.ivBase64.size() <= 128)
                 : (data.ciphertextBase64 is string && data.ciphertextBase64.size() == 0 &&
                    data.ivBase64 is string && data.ivBase64.size() == 0)
             ) &&
             data.sha256Checksum is string && data.sha256Checksum.size() == 64 &&
             data.encryptionAlgorithm == 'AES-256-GCM' &&
             data.status in ['pending', 'approved', 'flagged', 'archived'] &&
             data.uploaderUid is string && data.uploaderUid.size() >= 1 && data.uploaderUid.size() <= 128 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidEncryptedChunk(data) {
      return data.fileId is string && data.fileId.size() >= 1 && data.fileId.size() <= 128 &&
             data.catalogItemId is string && data.catalogItemId.size() >= 1 && data.catalogItemId.size() <= 128 &&
             data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex < 200 &&
             data.byteSize is int && data.byteSize > 0 && data.byteSize <= 550000 &&
             data.ciphertextBase64 is string && data.ciphertextBase64.size() >= 1 && data.ciphertextBase64.size() <= 900000 &&
             data.ivBase64 is string && data.ivBase64.size() >= 1 && data.ivBase64.size() <= 128 &&
             data.status in ['pending', 'approved', 'flagged', 'archived'] &&
             data.uploaderUid is string && data.uploaderUid.size() >= 1 && data.uploaderUid.size() <= 128 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.itemId is string && data.itemId.size() >= 1 && data.itemId.size() <= 128 &&
             data.itemTitle is string && data.itemTitle.size() >= 1 && data.itemTitle.size() <= 120 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
             data.moderationStatus in ['visible', 'flagged', 'hidden'] &&
             data.flagReason is string && data.flagReason.size() <= 300 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidReport(data) {
      return data.targetType in ['catalog_item', 'review'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.targetTitle is string && data.targetTitle.size() >= 1 && data.targetTitle.size() <= 120 &&
             data.reporterUid is string && data.reporterUid.size() >= 1 && data.reporterUid.size() <= 128 &&
             data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 80 &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 400 &&
             data.status in ['open', 'resolved', 'dismissed'] &&
             data.adminNotes is string && data.adminNotes.size() <= 400 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
             (!('actionUrl' in data) || (data.actionUrl is string && data.actionUrl.size() <= 512)) &&
             data.active is bool &&
             data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 120 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidBookmark(data, uid, itemId) {
      return data.userId == uid &&
             data.itemId == itemId &&
             data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Trusted Admin Role Markers (read-only from client SDK)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Published & Pending Apps/Links Catalog
    // Public guests can browse ONLY 'approved' items; all interactions/writes require Google Sign-In
    match /catalog_items/{itemId} {
      allow get: if isValidId(itemId) && (
        (resource != null && existing().status == 'approved') ||
        (isSignedIn() && (
          resource == null ||
          existing().uploaderUid == request.auth.uid ||
          isAdmin()
        ))
      );
      allow list: if (
        resource.data.status == 'approved' ||
        (isSignedIn() && (
          resource.data.uploaderUid == request.auth.uid ||
          isAdmin()
        ))
      );

      // Anyone signed in can upload, but non-admins MUST start in 'pending' status and cannot self-feature
      allow create: if isSignedIn() &&
                       isValidId(itemId) &&
                       isValidCatalogItem(incoming()) &&
                       incoming().uploaderUid == request.auth.uid &&
                       incoming().downloadCount == 0 &&
                       incoming().averageRating == 0 &&
                       incoming().reviewCount == 0 &&
                       incoming().keys().hasAll([
                         'title', 'description', 'category', 'itemType', 'version',
                         'fileSizeLabel', 'creatorHandle', 'encryptedTargetUrl', 'urlIv',
                         'encryptedFileId', 'sha256Checksum', 'encryptionAlgorithm', 'status',
                         'downloadCount', 'averageRating', 'reviewCount', 'uploaderUid',
                         'uploaderName', 'iconBase64', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'description', 'whatsNew', 'category', 'itemType', 'version',
                         'fileSizeLabel', 'creatorHandle', 'encryptedTargetUrl', 'urlIv',
                         'encryptedFileId', 'sha256Checksum', 'encryptionAlgorithm', 'status',
                         'isFeatured', 'moderationNote',
                         'downloadCount', 'averageRating', 'reviewCount', 'uploaderUid',
                         'uploaderName', 'iconBase64', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt <= request.time &&
                       (!('isFeatured' in incoming()) || !incoming().isFeatured || isAdmin()) &&
                       (!('moderationNote' in incoming()) || incoming().moderationNote == '' || isAdmin()) &&
                       (
                         incoming().status == 'pending' ||
                         (incoming().status == 'approved' && isAdmin())
                       );

      allow update: if isSignedIn() &&
                       isValidId(itemId) &&
                       isValidCatalogItem(incoming()) &&
                       incoming().uploaderUid == existing().uploaderUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt <= request.time && (
                         // Admin full edit / approval / featuring / moderation
                         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'description', 'whatsNew', 'category', 'itemType', 'version',
                           'fileSizeLabel', 'creatorHandle', 'encryptedTargetUrl', 'urlIv',
                           'encryptedFileId', 'sha256Checksum', 'encryptionAlgorithm', 'status',
                           'isFeatured', 'moderationNote', 'downloadCount', 'averageRating',
                           'reviewCount', 'uploaderName', 'iconBase64', 'updatedAt'
                         ])) ||
                         // Uploader can edit their own upload (resets to 'pending' for admin approval)
                         (existing().uploaderUid == request.auth.uid &&
                          existing().status in ['pending', 'approved', 'flagged'] &&
                          incoming().status == 'pending' &&
                          (!('isFeatured' in incoming()) || incoming().isFeatured == false ||
                            ('isFeatured' in existing() && incoming().isFeatured == existing().isFeatured)) &&
                          incoming().downloadCount == existing().downloadCount &&
                          incoming().averageRating == existing().averageRating &&
                          incoming().reviewCount == existing().reviewCount &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'description', 'whatsNew', 'category', 'itemType', 'version',
                            'fileSizeLabel', 'encryptedTargetUrl', 'urlIv', 'encryptedFileId',
                            'sha256Checksum', 'encryptionAlgorithm', 'uploaderName',
                            'iconBase64', 'status', 'updatedAt'
                          ])) ||
                         // Verified user download increment (+1 on approved items only)
                         (existing().status == 'approved' &&
                          incoming().status == 'approved' &&
                          incoming().downloadCount == existing().downloadCount + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount', 'updatedAt'])) ||
                         // Review aggregate recomputation on approved items
                         (existing().status == 'approved' &&
                          incoming().status == 'approved' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['averageRating', 'reviewCount', 'updatedAt'])) ||
                         // Community flag on approved items
                         (existing().status == 'approved' &&
                          incoming().status == 'flagged' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(itemId) && (existing().uploaderUid == request.auth.uid || isAdmin());
    }

    // Encrypted File Vault Blobs & Chunked Manifests (up to 50 MB) — requires sign-in to download/upload
    match /encrypted_files/{fileId} {
      allow get: if isSignedIn() && isValidId(fileId) && (
        resource == null ||
        existing().status == 'approved' ||
        existing().uploaderUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'approved' ||
        resource.data.uploaderUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(fileId) &&
                       isValidEncryptedFile(incoming()) &&
                       incoming().uploaderUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'catalogItemId', 'fileName', 'mimeType', 'byteSize', 'chunkCount',
                         'ciphertextBase64', 'ivBase64', 'sha256Checksum',
                         'encryptionAlgorithm', 'status', 'uploaderUid',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'catalogItemId', 'fileName', 'mimeType', 'byteSize', 'chunkCount',
                         'ciphertextBase64', 'ivBase64', 'sha256Checksum',
                         'encryptionAlgorithm', 'status', 'uploaderUid',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt <= request.time &&
                       (
                         incoming().status == 'pending' ||
                         (incoming().status == 'approved' && isAdmin())
                       );

      allow update: if isSignedIn() &&
                       isValidId(fileId) &&
                       isValidEncryptedFile(incoming()) &&
                       incoming().uploaderUid == existing().uploaderUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt <= request.time && (
                         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
                           'catalogItemId', 'fileName', 'mimeType', 'byteSize', 'chunkCount',
                           'ciphertextBase64', 'ivBase64', 'sha256Checksum',
                           'encryptionAlgorithm', 'status', 'updatedAt'
                         ])) ||
                         (existing().uploaderUid == request.auth.uid &&
                          incoming().status == 'pending' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(fileId) && (existing().uploaderUid == request.auth.uid || isAdmin());

      // Encrypted Chunks Subcollection — requires sign-in
      match /chunks/{chunkId} {
        allow get: if isSignedIn() && isValidId(fileId) && isValidId(chunkId) && (
          resource == null ||
          existing().status == 'approved' ||
          existing().uploaderUid == request.auth.uid ||
          isAdmin()
        );
        allow list: if isSignedIn() && isValidId(fileId) && (
          resource.data.status == 'approved' ||
          resource.data.uploaderUid == request.auth.uid ||
          isAdmin()
        );

        allow create: if isSignedIn() &&
                         isValidId(fileId) &&
                         isValidId(chunkId) &&
                         isValidEncryptedChunk(incoming()) &&
                         incoming().fileId == fileId &&
                         incoming().uploaderUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'fileId', 'catalogItemId', 'chunkIndex', 'byteSize',
                           'ciphertextBase64', 'ivBase64', 'status', 'uploaderUid',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'fileId', 'catalogItemId', 'chunkIndex', 'byteSize',
                           'ciphertextBase64', 'ivBase64', 'status', 'uploaderUid',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt <= request.time &&
                         (
                           incoming().status == 'pending' ||
                           (incoming().status == 'approved' && isAdmin())
                         );

        allow update: if isSignedIn() &&
                         isValidId(fileId) &&
                         isValidId(chunkId) &&
                         isValidEncryptedChunk(incoming()) &&
                         incoming().uploaderUid == existing().uploaderUid &&
                         incoming().fileId == existing().fileId &&
                         incoming().chunkIndex == existing().chunkIndex &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                         (isAdmin() || (existing().uploaderUid == request.auth.uid && incoming().status == 'pending'));

        allow delete: if isSignedIn() && isValidId(fileId) && isValidId(chunkId) && (existing().uploaderUid == request.auth.uid || isAdmin());
      }
    }

    // User Ratings & Reviews: guests can view 'visible' reviews; sign-in required to write/edit/flag
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (
        (resource != null && existing().moderationStatus == 'visible') ||
        (isSignedIn() && (
          resource == null ||
          existing().userId == request.auth.uid ||
          isAdmin()
        ))
      );
      allow list: if (
        resource.data.moderationStatus == 'visible' ||
        (isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isAdmin()
        ))
      );

      allow create: if isSignedIn() &&
                       isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().moderationStatus == 'visible' &&
                       incoming().flagReason == '' &&
                       incoming().keys().hasAll([
                         'itemId', 'itemTitle', 'userId', 'authorName',
                         'rating', 'comment', 'moderationStatus', 'flagReason',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'itemId', 'itemTitle', 'userId', 'authorName',
                         'rating', 'comment', 'moderationStatus', 'flagReason',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt <= request.time &&
                       exists(/databases/$(database)/documents/catalog_items/$(incoming().itemId));

      allow update: if isSignedIn() &&
                       isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().itemId == existing().itemId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt <= request.time && (
                         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus', 'flagReason', 'updatedAt'])) ||
                         (existing().userId == request.auth.uid &&
                          existing().moderationStatus != 'hidden' &&
                          incoming().moderationStatus == existing().moderationStatus &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'authorName', 'updatedAt'])) ||
                         (existing().moderationStatus == 'visible' &&
                          incoming().moderationStatus == 'flagged' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus', 'flagReason', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(reviewId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Content Moderation Reports Queue (signed-in only)
    match /moderation_reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (resource == null || existing().reporterUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidReport(incoming()) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().adminNotes == '' &&
                       incoming().keys().hasAll([
                         'targetType', 'targetId', 'targetTitle', 'reporterUid',
                         'reporterName', 'reason', 'status', 'adminNotes',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'targetType', 'targetId', 'targetTitle', 'reporterUid',
                         'reporterName', 'reason', 'status', 'adminNotes',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidReport(incoming()) &&
                       incoming().reporterUid == existing().reporterUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']) &&
                       isAdmin();

      allow delete: if isSignedIn() && isValidId(reportId) && isAdmin();
    }

    // Admin Broadcast Announcements (publicly readable when active; admin-only write)
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && ((resource != null && existing().active == true) || isAdmin());
      allow list: if resource.data.active == true || isAdmin();

      allow create: if isAdmin() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming()) &&
                       incoming().keys().hasAll([
                         'title', 'message', 'active', 'authorEmail', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'message', 'actionUrl', 'active', 'authorEmail', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt <= request.time;

      allow update: if isAdmin() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'actionUrl', 'active', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // User Saved Bookmarks (strictly per-user owner isolated)
    match /users/{userId}/bookmarks/{itemId} {
      allow get, list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(itemId) &&
                       request.auth.uid == userId &&
                       isValidBookmark(incoming(), userId, itemId) &&
                       incoming().keys().hasAll(['userId', 'itemId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'itemId', 'createdAt']) &&
                       incoming().createdAt <= request.time;
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
    }
  }
}
